# Port the browser-facing WebSocket server listens on
PORT=4000

# Fallback SOL/USD price (auto-refreshed from CoinGecko every 5 min if reachable)
SOL_USD=150

# Upstream PumpPortal data stream
PUMPPORTAL_WS=wss://pumpportal.fun/api/data

# PumpPortal API key. subscribeNewToken & subscribeMigration are free; the trade
# subscriptions (subscribeTokenTrade / subscribeAccountTrade — needed for the
# live buys/sells counter, live charts, holder counts) require a key from a
# wallet funded with at least 0.02 SOL (~$2 one-time). Get one at:
#     https://pumpportal.fun/trading-api
# Without the key the worker still streams new launches; trade data falls back
# to "0 / 0 since launch".
PUMPPORTAL_API_KEY=

# Where POST /api/waitlist appends one JSON line per signup.
# Defaults to ~/.pumpradar-waitlist.jsonl
WAITLIST_FILE=
