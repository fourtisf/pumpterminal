# Public env vars (exposed to browser - prefix with NEXT_PUBLIC_)
# Leave NEXT_PUBLIC_WS_URL empty to run in mock mode (default for local dev).
# Point it at the worker (../worker) for the live feed + token detail charts.
NEXT_PUBLIC_WS_URL=

# Solana RPC for /wallet + /roast lookups. Defaults to the public mainnet
# endpoint, which is heavily rate-limited — set a dedicated one (free Helius /
# QuickNode key) for anything real. NEXT_PUBLIC_* is inlined at build time.
NEXT_PUBLIC_SOLANA_RPC=

# Server-only (used in API routes & server components)
HELIUS_API_KEY=
ANTHROPIC_API_KEY=
DATABASE_URL=postgresql://user:password@localhost:5432/pumpradar
REDIS_URL=redis://localhost:6379
